module main
  port in "from NITS" : composite
  port out "to NITS" : composite
  port in "Control Commands Type 3 front" : composite
  port out "Simple IF RX" : composite
  port out "Extended Commands RX" : composite
  port in "Rolling Stock Status w/ Inertia Composite" : composite
  port in "CP Request" : boolean
  port in "Door Open (A)" : boolean
  port in "Door Open (B)" : boolean
  port in "SOS Button 1" : boolean
  port in "Battery" : number
  port out "Rolling Stock Settings" : composite
  port in "SOS Button 2" : boolean
  port in "Inertia Composite" : composite
  port out "SOS Button" : boolean

  # --- Configuration properties ---
  inst PROPERTY_TEXT nits_ext_id_property (name="NITS Ext. ID", v=240001) : ->
  inst PROPERTY_DROPDOWN cab_property (items="[{\"l\":\"None\",\"value\":\"0\"},{\"l\":\"Front\",\"value\":\"2\"},{\"l\":\"Rear\",\"value\":\"1\"},{\"l\":\"Both\",\"value\":\"3\"}]", i=1, name="Cab") : -> out=cab_property_out
  inst PROPERTY_DROPDOWN powered_axle_property (items="[{\"l\":\"None\",\"value\":\"0\"},{\"l\":\"Front only\",\"value\":\"2\"},{\"l\":\"Rear only\",\"value\":\"1\"},{\"l\":\"Both\",\"value\":\"3\"}]", name="Powered Axle") : -> out=powered_axle_property_out
  inst PROPERTY_DROPDOWN side_doors_property (items="[{\"l\":\"0\",\"value\":\"0\"},{\"l\":\"1\",\"value\":\"1\"},{\"l\":\"2\",\"value\":\"2\"},{\"l\":\"3\",\"value\":\"3\"},{\"l\":\"4\",\"value\":\"4\"},{\"l\":\"5\",\"value\":\"5\"},{\"l\":\"6\",\"value\":\"6\"}]", i=3, name="Side doors") : -> out=side_doors_property_out
  inst PROPERTY_DROPDOWN front_pantograph_type_property (items="[{\"l\":\"None\",\"value\":\"0\"},{\"l\":\"Single arm inner\",\"value\":\"1\"},{\"l\":\"Single arm outer\",\"value\":\"2\"},{\"l\":\"Diamond\",\"value\":\"3\"}]", name="Front Pantograph") : -> out=front_pantograph_type_property_out
  inst PROPERTY_DROPDOWN rear_pantograph_type_property (items="[{\"l\":\"None\",\"value\":\"0\"},{\"l\":\"Single arm inner\",\"value\":\"1\"},{\"l\":\"Single arm outer\",\"value\":\"2\"},{\"l\":\"Diamond\",\"value\":\"3\"}]", name="Rear Pantograph") : -> out=rear_pantograph_type_property_out
  inst PROPERTY_DROPDOWN double_decker_property (items="[{\"l\":\"No\",\"value\":\"0\"},{\"l\":\"Yes\",\"value\":\"1\"}]", name="Double Decker") : -> out=double_decker_property_out
  inst PROPERTY_TOGGLE car_count_direction_toggle_property (label="", on_label="Front is 1 / Up", off_label="Back is 1 / Down", n="Car count", v=true) : -> out=car_count_direction_toggle_property_out

  # --- NITS RX: decode incoming NITS bus frame ---
  inst LUA nits_rx_decoder_lua (script_ref="scripts/n466.lua") : composite="from NITS" -> composite=nits_rx_decoder_lua_composite
  inst COMPOSITE_READ_BOOLEAN rx_addr_conflict_read (channel=13) : composite=nits_rx_decoder_lua_composite -> out=rx_addr_conflict_read_out
  inst COMPOSITE_READ_BOOLEAN rx_addr_not_mine_read (channel=14) : composite=nits_rx_decoder_lua_composite -> out=rx_addr_not_mine_read_out
  inst COMPOSITE_READ_BOOLEAN rx_addr_matched_read (channel=31) : composite=nits_rx_decoder_lua_composite -> out=rx_addr_matched_read_out
  inst COMPOSITE_READ_BOOLEAN nits_rx_raw_passthrough_bit (channel=11) : composite="from NITS" -> out=nits_rx_raw_passthrough_bit_out
  inst COMPOSITE_READ_BOOLEAN rx_decoded_op1_read (channel=1) : composite=nits_rx_decoder_lua_composite -> out=rx_decoded_op1_read_out

  # --- Simple IF RX: pass consist status back to own car ---
  inst OR simpleif_rx_status_bit : a=nits_rx_raw_passthrough_bit_out, b=rx_decoded_op1_read_out -> out=simpleif_rx_status_bit_out
  inst COMPOSITE_WRITE_BOOLEAN simpleif_rx_bus_write (count=1, offset=1) : in1=simpleif_rx_status_bit_out, inc=nits_rx_decoder_lua_composite -> out="Simple IF RX"

  # --- Address-match latch / local-mode gating ---
  inst SR_LATCH ext_mode_latch : r=rx_addr_not_mine_read_out, s=rx_addr_matched_read_out -> q=ext_mode_latch_q
  inst CAPACITOR local_mode_timer (charge_time=3, discharge_time=0) : enable=ext_mode_latch_q -> out=local_mode_timer_out

  # --- Car position & consist size ---
  inst COMPOSITE_READ_NUMBER front_car_count_read (channel=4) : composite=nits_rx_decoder_lua_composite -> out=front_car_count_read_out
  inst COMPOSITE_READ_NUMBER last_car_count_read (channel=5) : composite=nits_rx_decoder_lua_composite -> out=last_car_count_read_out
  inst NUM_SWITCHBOX car_count_switchbox : a=front_car_count_read_out, b=last_car_count_read_out, switch=car_count_direction_toggle_property_out -> out=car_count_switchbox_out
  inst FUNC_NUM_1 car_position_number (expression="x+1") : x=car_count_switchbox_out -> out=car_position_number_out
  inst COMPOSITE_READ_NUMBER total_car_count_for_nits_read (channel=6) : composite=nits_rx_decoder_lua_composite -> out=total_car_count_for_nits_read_out
  inst COMPOSITE_READ_NUMBER total_car_count_for_door_calc_read (channel=6) : composite=nits_rx_decoder_lua_composite -> out=total_car_count_for_door_calc_read_out

  # --- NITS TX: crash-detect watchdog / strobe ---
  inst LUA nits_tx_encoder_lua (script_ref="scripts/n440.lua") : composite=nits_tx_command_write_out -> composite=nits_tx_encoder_lua_composite
  inst COMPOSITE_READ_BOOLEAN nits_tx_watchdog_read (channel=1) : composite=nits_tx_encoder_lua_composite -> out=nits_tx_watchdog_read_out
  inst NOT nits_tx_watchdog_not : a=nits_tx_watchdog_read_out -> out=nits_tx_watchdog_not_out
  inst XOR nits_tx_watchdog_xor : a=nits_tx_watchdog_read_out, b=nits_tx_watchdog_not_out -> out=nits_tx_watchdog_xor_out
  inst NOT nits_tx_watchdog_xor_not : a=nits_tx_watchdog_xor_out -> out=nits_tx_watchdog_xor_not_out
  inst CAPACITOR nits_tx_strobe_cap (charge_time=0, discharge_time=0.1) : enable=nits_tx_watchdog_xor_not_out -> out=nits_tx_strobe_cap_out

  # --- Control Commands Type 3 (front): direct reads ---
  inst COMPOSITE_READ_BOOLEAN cc3_front_direction_select_front_read (channel=6) : composite="Control Commands Type 3 front" -> out=cc3_front_direction_select_front_read_out
  inst COMPOSITE_READ_BOOLEAN cc3_front_emergency_brake_read (channel=1) : composite="Control Commands Type 3 front" -> out=cc3_front_emergency_brake_read_out
  inst COMPOSITE_READ_BOOLEAN cc3_front_direction_select_back_read (channel=7) : composite="Control Commands Type 3 front" -> out=cc3_front_direction_select_back_read_out
  inst COMPOSITE_READ_BOOLEAN cc3_front_direction_select_conflict_read (channel=9) : composite="Control Commands Type 3 front" -> out=cc3_front_direction_select_conflict_read_out
  inst COMPOSITE_READ_BOOLEAN cc3_front_id_tx_flag_read (channel=32) : composite="Control Commands Type 3 front" -> out=cc3_front_id_tx_flag_read_out
  inst NOT to_nits_reserved_bit_fixed_value : a=to_nits_reserved_bit_base_const_out -> out=to_nits_reserved_bit_fixed_value_out
  inst CONST_BOOL to_nits_reserved_bit_base_const : -> out=to_nits_reserved_bit_base_const_out

  # --- Car fault aggregation ---
  inst COMPOSITE_READ_BOOLEAN motor_lua_fault_read (channel=1) : composite="Rolling Stock Status w/ Inertia Composite" -> out=motor_lua_fault_read_out
  inst COMPOSITE_READ_BOOLEAN fault_info_4_read (channel=2) : composite="Rolling Stock Status w/ Inertia Composite" -> out=fault_info_4_read_out
  inst LESS_THAN low_battery_check : a="Battery", b=low_battery_threshold_const_value -> out=low_battery_check_out
  inst CONST low_battery_threshold_const (value=0.8) : -> value=low_battery_threshold_const_value
  inst OR sos_button_or : a="SOS Button 1", b="SOS Button 2" -> out=sos_button_or_out, out="SOS Button"
  inst BOOL_FUNC_4 car_fault_report_or (expression="x|y|z|w") : x=sos_button_or_out, y=low_battery_check_out, z=motor_lua_fault_read_out, w=fault_info_4_read_out -> out=car_fault_report_or_out

  # --- Rolling Stock Settings / motor current gating ---
  inst COMPOSITE_READ_NUMBER brake_cylinder_pressure_read (channel=2) : composite="Rolling Stock Status w/ Inertia Composite" -> out=brake_cylinder_pressure_read_out
  inst COMPOSITE_READ_NUMBER motor_current_read (channel=3) : composite="Rolling Stock Status w/ Inertia Composite" -> out=motor_current_read_out
  inst GREATER_THAN powered_axle_present_check : a=powered_axle_property_out -> out=powered_axle_present_check_out
  inst COMPOSITE_WRITE_BOOLEAN rolling_stock_settings_write (count=2, offset=1) : in1=powered_axle_present_check_out, in2=car_count_direction_toggle_property_out, inc="Inertia Composite" -> out=rolling_stock_settings_write_out, out="Rolling Stock Settings"
  inst COMPOSITE_READ_BOOLEAN powered_axle_present_readback (channel=1) : composite=rolling_stock_settings_write_out -> out=powered_axle_present_readback_out
  inst NUM_SWITCHBOX motor_current_gated_by_axle : a=motor_current_read_out, switch=powered_axle_present_readback_out -> out=motor_current_gated_by_axle_out

  # --- Extended Commands: door status decode & memory register bus ---
  inst LUA door_status_decoder_lua (script_ref="scripts/n688.lua") : composite=door_decoder_input_write_out -> composite=door_status_decoder_lua_composite
  inst COMPOSITE_WRITE_BOOLEAN door_decoder_input_write (count=1, offset=1) : in1=local_mode_timer_out, inc="from NITS" -> out=door_decoder_input_write_out
  inst COMPOSITE_WRITE_NUMBER memory_register_bus_input_write (count=8, offset=1) : in1=memory_register_1_out, in2=memory_register_2_out, in3=memory_register_3_out, in4=memory_register_4_out, in5=memory_register_5_out, in6=memory_register_6_out, in7=memory_register_7_out, in8=memory_register_8_out, inc=door_status_decoder_lua_composite -> out=memory_register_bus_input_write_out
  inst LUA memory_register_bus_lua (script_ref="scripts/n691.lua") : composite=memory_register_bus_input_write_out -> composite=memory_register_bus_lua_composite
  inst COMPOSITE_READ_BOOLEAN memory_register_1_set_read (channel=1) : composite=memory_register_bus_lua_composite -> out=memory_register_1_set_read_out
  inst COMPOSITE_READ_NUMBER memory_register_1_value_read (channel=1) : composite=memory_register_bus_lua_composite -> out=memory_register_1_value_read_out
  inst MEMORY_REGISTER memory_register_1 (reset_value=0) : set=memory_register_1_set_read_out, value=memory_register_1_value_read_out -> out=memory_register_1_out
  inst COMPOSITE_READ_BOOLEAN memory_register_2_set_read (channel=2) : composite=memory_register_bus_lua_composite -> out=memory_register_2_set_read_out
  inst COMPOSITE_READ_NUMBER memory_register_2_value_read (channel=2) : composite=memory_register_bus_lua_composite -> out=memory_register_2_value_read_out
  inst MEMORY_REGISTER memory_register_2 (reset_value=0) : set=memory_register_2_set_read_out, value=memory_register_2_value_read_out -> out=memory_register_2_out
  inst COMPOSITE_READ_BOOLEAN memory_register_3_set_read (channel=3) : composite=memory_register_bus_lua_composite -> out=memory_register_3_set_read_out
  inst COMPOSITE_READ_NUMBER memory_register_3_value_read (channel=3) : composite=memory_register_bus_lua_composite -> out=memory_register_3_value_read_out
  inst MEMORY_REGISTER memory_register_3 (reset_value=0) : set=memory_register_3_set_read_out, value=memory_register_3_value_read_out -> out=memory_register_3_out
  inst COMPOSITE_READ_BOOLEAN memory_register_4_set_read (channel=4) : composite=memory_register_bus_lua_composite -> out=memory_register_4_set_read_out
  inst COMPOSITE_READ_NUMBER memory_register_4_value_read (channel=4) : composite=memory_register_bus_lua_composite -> out=memory_register_4_value_read_out
  inst MEMORY_REGISTER memory_register_4 (reset_value=0) : set=memory_register_4_set_read_out, value=memory_register_4_value_read_out -> out=memory_register_4_out
  inst COMPOSITE_READ_BOOLEAN memory_register_5_set_read (channel=5) : composite=memory_register_bus_lua_composite -> out=memory_register_5_set_read_out
  inst COMPOSITE_READ_NUMBER memory_register_5_value_read (channel=5) : composite=memory_register_bus_lua_composite -> out=memory_register_5_value_read_out
  inst MEMORY_REGISTER memory_register_5 (reset_value=0) : set=memory_register_5_set_read_out, value=memory_register_5_value_read_out -> out=memory_register_5_out
  inst COMPOSITE_READ_BOOLEAN memory_register_6_set_read (channel=6) : composite=memory_register_bus_lua_composite -> out=memory_register_6_set_read_out
  inst COMPOSITE_READ_NUMBER memory_register_6_value_read (channel=6) : composite=memory_register_bus_lua_composite -> out=memory_register_6_value_read_out
  inst MEMORY_REGISTER memory_register_6 (reset_value=0) : set=memory_register_6_set_read_out, value=memory_register_6_value_read_out -> out=memory_register_6_out
  inst COMPOSITE_READ_BOOLEAN memory_register_7_set_read (channel=7) : composite=memory_register_bus_lua_composite -> out=memory_register_7_set_read_out
  inst COMPOSITE_READ_NUMBER memory_register_7_value_read (channel=7) : composite=memory_register_bus_lua_composite -> out=memory_register_7_value_read_out
  inst MEMORY_REGISTER memory_register_7 (reset_value=0) : set=memory_register_7_set_read_out, value=memory_register_7_value_read_out -> out=memory_register_7_out
  inst COMPOSITE_READ_BOOLEAN memory_register_8_set_read (channel=8) : composite=memory_register_bus_lua_composite -> out=memory_register_8_set_read_out
  inst COMPOSITE_READ_NUMBER memory_register_8_value_read (channel=8) : composite=memory_register_bus_lua_composite -> out=memory_register_8_value_read_out
  inst MEMORY_REGISTER memory_register_8 (reset_value=0) : set=memory_register_8_set_read_out, value=memory_register_8_value_read_out -> out=memory_register_8_out
  inst COMPOSITE_READ_BOOLEAN door_mode_ready_read (channel=1) : composite=door_status_decoder_lua_composite -> out=door_mode_ready_read_out
  inst COMPOSITE_READ_NUMBER door_mode_value_read (channel=1) : composite=door_status_decoder_lua_composite -> out=door_mode_value_read_out
  inst MEMORY_REGISTER door_mode_register (reset_value=0) : set=door_mode_ready_read_out, value=door_mode_value_read_out -> out=door_mode_register_out
  inst COMPOSITE_READ_BOOLEAN doorcut_front_ready_read (channel=2) : composite=door_status_decoder_lua_composite -> out=doorcut_front_ready_read_out
  inst COMPOSITE_READ_NUMBER doorcut_front_value_read (channel=2) : composite=door_status_decoder_lua_composite -> out=doorcut_front_value_read_out
  inst MEMORY_REGISTER doorcut_front_register (reset_value=0) : set=doorcut_front_ready_read_out, value=doorcut_front_value_read_out -> out=doorcut_front_register_out
  inst COMPOSITE_READ_NUMBER doorcut_front_local_value_read (channel=4) : composite=door_status_decoder_lua_composite -> out=doorcut_front_local_value_read_out
  inst MEMORY_REGISTER doorcut_front_local_register (reset_value=0) : set=doorcut_front_ready_read_out, value=doorcut_front_local_value_read_out -> out=doorcut_front_local_register_out
  inst COMPOSITE_READ_BOOLEAN doorcut_back_ready_read (channel=3) : composite=door_status_decoder_lua_composite -> out=doorcut_back_ready_read_out
  inst COMPOSITE_READ_NUMBER doorcut_back_value_read (channel=3) : composite=door_status_decoder_lua_composite -> out=doorcut_back_value_read_out
  inst MEMORY_REGISTER doorcut_back_register (reset_value=0) : set=doorcut_back_ready_read_out, value=doorcut_back_value_read_out -> out=doorcut_back_register_out
  inst COMPOSITE_READ_NUMBER doorcut_back_local_value_read (channel=5) : composite=door_status_decoder_lua_composite -> out=doorcut_back_local_value_read_out
  inst MEMORY_REGISTER doorcut_back_local_register (reset_value=0) : set=doorcut_back_ready_read_out, value=doorcut_back_local_value_read_out -> out=doorcut_back_local_register_out
  inst FUNC_NUM_1 door_mode_passthrough (expression="x") : x=door_mode_register_out -> out=door_mode_passthrough_out
  inst FUNC_NUM_1 doorcut_front_passthrough (expression="x") : x=doorcut_front_register_out -> out=doorcut_front_passthrough_out
  inst FUNC_NUM_1 doorcut_back_passthrough (expression="x") : x=doorcut_back_register_out -> out=doorcut_back_passthrough_out
  inst FUNC_NUM_1 doorcut_front_local_passthrough (expression="x") : x=doorcut_front_local_register_out -> out=doorcut_front_local_passthrough_out
  inst FUNC_NUM_1 doorcut_back_local_passthrough (expression="x") : x=doorcut_back_local_register_out -> out=doorcut_back_local_passthrough_out

  # --- Extended Commands: per-car info packer (consist broadcast decode) ---
  inst LUA car_info_packer_lua (script_ref="scripts/n523.lua") : composite=car_info_packer_input_write_out -> composite=car_info_packer_lua_composite
  inst COMPOSITE_WRITE_BOOLEAN car_info_packer_input_write (count=1, offset=32) : in1=local_mode_timer_out, inc="from NITS" -> out=car_info_packer_input_write_out
  inst COMPOSITE_READ_NUMBER packed_car_power_brake_number_read (channel=1) : composite=car_info_packer_lua_composite -> out=packed_car_power_brake_number_read_out
  inst COMPOSITE_READ_NUMBER packed_car_fault_status_number_read (channel=2) : composite=car_info_packer_lua_composite -> out=packed_car_fault_status_number_read_out
  inst COMPOSITE_READ_NUMBER packed_car_door_status_number_read (channel=3) : composite=car_info_packer_lua_composite -> out=packed_car_door_status_number_read_out
  inst COMPOSITE_READ_BOOLEAN front_neighbor_car_isolated_read (channel=31) : composite=car_info_packer_lua_composite -> out=front_neighbor_car_isolated_read_out
  inst COMPOSITE_READ_BOOLEAN rear_neighbor_car_isolated_read (channel=32) : composite=car_info_packer_lua_composite -> out=rear_neighbor_car_isolated_read_out
  inst COMPOSITE_READ_BOOLEAN cross_seat_shiokata_remote_read (channel=16) : composite=car_info_packer_lua_composite -> out=cross_seat_shiokata_remote_read_out
  inst COMPOSITE_READ_BOOLEAN cross_seat_suhou_remote_read (channel=15) : composite=car_info_packer_lua_composite -> out=cross_seat_suhou_remote_read_out
  inst COMPOSITE_READ_BOOLEAN long_seat_remote_read (channel=14) : composite=car_info_packer_lua_composite -> out=long_seat_remote_read_out

  # --- Extended Commands: internal latches (room light / info display / pantograph / heater / brake boost / CP / high-accel / SIV / chime / door / isolation) ---
  inst SR_LATCH room_light_latch : r=room_light_off_or_out, s=room_light_on_or_out -> q=room_light_latch_q
  inst COMPOSITE_READ_BOOLEAN room_light_off_local_read (channel=19) : composite=door_status_decoder_lua_composite -> out=room_light_off_local_read_out
  inst OR room_light_off_or : a=room_light_off_local_read_out, b=room_light_off_remote_read_out -> out=room_light_off_or_out
  inst COMPOSITE_READ_BOOLEAN room_light_on_local_read (channel=20) : composite=door_status_decoder_lua_composite -> out=room_light_on_local_read_out
  inst OR room_light_on_or : a=room_light_on_local_read_out, b=room_light_on_remote_read_out -> out=room_light_on_or_out
  inst COMPOSITE_READ_BOOLEAN room_light_on_remote_read (channel=23) : composite=nits_rx_decoder_lua_composite -> out=room_light_on_remote_read_out
  inst COMPOSITE_READ_BOOLEAN room_light_off_remote_read (channel=24) : composite=nits_rx_decoder_lua_composite -> out=room_light_off_remote_read_out
  inst SR_LATCH passenger_info_display_latch : r=passenger_info_off_or_out, s=passenger_info_on_or_out -> q=passenger_info_display_latch_q
  inst COMPOSITE_READ_BOOLEAN passenger_info_off_local_read (channel=21) : composite=door_status_decoder_lua_composite -> out=passenger_info_off_local_read_out
  inst OR passenger_info_off_or : a=passenger_info_off_local_read_out, b=passenger_info_off_remote_read_out -> out=passenger_info_off_or_out
  inst COMPOSITE_READ_BOOLEAN passenger_info_on_local_read (channel=22) : composite=door_status_decoder_lua_composite -> out=passenger_info_on_local_read_out
  inst OR passenger_info_on_or : a=passenger_info_on_local_read_out, b=passenger_info_on_remote_read_out -> out=passenger_info_on_or_out
  inst COMPOSITE_READ_BOOLEAN passenger_info_on_remote_read (channel=19) : composite=nits_rx_decoder_lua_composite -> out=passenger_info_on_remote_read_out
  inst COMPOSITE_READ_BOOLEAN passenger_info_off_remote_read (channel=20) : composite=nits_rx_decoder_lua_composite -> out=passenger_info_off_remote_read_out
  inst COMPOSITE_READ_BOOLEAN front_pantograph_lock_local_read (channel=16) : composite=door_status_decoder_lua_composite -> out=front_pantograph_lock_local_read_out
  inst COMPOSITE_READ_BOOLEAN front_pantograph_raise_lower_local_read (channel=15) : composite=door_status_decoder_lua_composite -> out=front_pantograph_raise_lower_local_read_out
  inst COMPOSITE_READ_BOOLEAN pantograph_raise_signal_read (channel=6) : composite=nits_rx_decoder_lua_composite -> out=pantograph_raise_signal_read_out
  inst COMPOSITE_READ_BOOLEAN pantograph_lower_signal_read (channel=7) : composite=nits_rx_decoder_lua_composite -> out=pantograph_lower_signal_read_out
  inst COMPOSITE_READ_BOOLEAN rear_pantograph_lock_local_read (channel=14) : composite=door_status_decoder_lua_composite -> out=rear_pantograph_lock_local_read_out
  inst COMPOSITE_READ_BOOLEAN rear_pantograph_raise_lower_local_read (channel=13) : composite=door_status_decoder_lua_composite -> out=rear_pantograph_raise_lower_local_read_out
  inst SR_LATCH isolate_via_neighbor_latch : r=isolate_via_neighbor_reset_or_out, s=isolate_via_neighbor_start_read_out -> q=isolate_via_neighbor_latch_q
  inst COMPOSITE_READ_BOOLEAN own_car_isolate_direct_read (channel=8) : composite=cc3_ext_packed_bool_to_composite_out -> out=own_car_isolate_direct_read_out
  inst COMPOSITE_READ_BOOLEAN isolate_via_neighbor_end_read (channel=23) : composite=door_status_decoder_lua_composite -> out=isolate_via_neighbor_end_read_out
  inst COMPOSITE_READ_BOOLEAN isolate_via_neighbor_start_read (channel=24) : composite=door_status_decoder_lua_composite -> out=isolate_via_neighbor_start_read_out
  inst PULSE own_car_isolate_direct_rise_pulse (mode="rise") : a=own_car_isolate_direct_read_out -> out=own_car_isolate_direct_rise_pulse_out
  inst OR isolate_via_neighbor_reset_or : a=isolate_via_neighbor_end_read_out, b=own_car_isolate_direct_rise_pulse_out -> out=isolate_via_neighbor_reset_or_out
  inst SR_LATCH heater_latch : r=heater_off_or_out, s=heater_on_or_out -> q=heater_latch_q
  inst COMPOSITE_READ_BOOLEAN heater_off_local_read (channel=17) : composite=door_status_decoder_lua_composite -> out=heater_off_local_read_out
  inst OR heater_off_or : a=heater_off_local_read_out, b=heater_off_remote_read_out -> out=heater_off_or_out
  inst COMPOSITE_READ_BOOLEAN heater_on_local_read (channel=18) : composite=door_status_decoder_lua_composite -> out=heater_on_local_read_out
  inst OR heater_on_or : a=heater_on_local_read_out, b=heater_on_remote_read_out -> out=heater_on_or_out
  inst COMPOSITE_READ_BOOLEAN heater_on_remote_read (channel=25) : composite=nits_rx_decoder_lua_composite -> out=heater_on_remote_read_out
  inst COMPOSITE_READ_BOOLEAN heater_off_remote_read (channel=26) : composite=nits_rx_decoder_lua_composite -> out=heater_off_remote_read_out
