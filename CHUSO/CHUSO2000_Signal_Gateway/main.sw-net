  inst COMPOSITE_READ_BOOLEAN brake_boost_end_remote_read (channel=19) : composite=car_info_packer_lua_composite -> out=brake_boost_end_remote_read_out
  inst COMPOSITE_READ_BOOLEAN brake_boost_start_remote_read (channel=20) : composite=car_info_packer_lua_composite -> out=brake_boost_start_remote_read_out
