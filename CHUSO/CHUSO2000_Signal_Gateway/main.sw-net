  inst COMPOSITE_READ_BOOLEAN passenger_info_display_latch_readback (channel=3) : composite=extended_commands_bool_write_out -> out=passenger_info_display_latch_readback_out
  inst COMPOSITE_READ_BOOLEAN own_car_isolation_readback (channel=10) : composite=extended_commands_bool_write_out -> out=own_car_isolation_readback_out
  inst GREATER_THAN powering_check : a=motor_current_gated_by_axle_out -> out=powering_check_out
  inst LESS_THAN regen_check : a=motor_current_gated_by_axle_out -> out=regen_check_out
  inst CONST_BOOL pantograph_status_placeholder_const : -> out=pantograph_status_placeholder_const_out
  inst NOT pantograph_status_placeholder_true : a=pantograph_status_placeholder_const_out -> out=pantograph_status_placeholder_true_out
  inst OR pantograph_status_placeholder_false : a=pantograph_status_placeholder_const_out -> out=pantograph_status_placeholder_false_out
  inst COMPOSITE_WRITE_BOOLEAN car_status_bool_write (count=31, offset=2) : in1="Door Open (B)", in2="Door Open (B)", in3="Door Open (B)", in4="Door Open (B)", in5="Door Open (B)", in6="Door Open (B)", in7="Door Open (A)", in8="Door Open (A)", in9="Door Open (A)", in10="Door Open (A)", in11="Door Open (A)", in12="Door Open (A)", in13=pantograph1_lock_status_read_out, in14=pantograph1_raised_status_read_out, in15=pantograph2_lock_status_read_out, in16=pantograph2_raised_status_read_out, in17=heater_latch_readback_out, in18=room_light_latch_readback_out, in19=passenger_info_display_latch_readback_out, in20=own_car_isolation_readback_out, in21=sos_button_or_out, in22=regen_check_out, in23=powering_check_out, in24=pantograph_status_placeholder_false_out, in25=pantograph_status_placeholder_false_out, in26=pantograph_status_placeholder_true_out, in27=pantograph_status_placeholder_false_out, in28=pantograph_status_placeholder_true_out, in29=pantograph_status_placeholder_true_out, in30=pantograph_status_placeholder_false_out, in31=pantograph_status_placeholder_true_out -> out=car_status_bool_write_out
  inst COMPOSITE_TO_NUMBER car_status_number_encode : composite=car_status_bool_write_out -> out=car_status_number_encode_out

  # --- Simple IF TX: encode own status to NITS bus ---
  inst COMPOSITE_READ_NUMBER cc3_ext_packed_bool_number_read (channel=7) : composite="Control Commands Type 3 front" -> out=cc3_ext_packed_bool_number_read_out
  inst COMPOSITE_READ_NUMBER cc3_ext_0x4c_info_read (channel=6) : composite="Control Commands Type 3 front" -> out=cc3_ext_0x4c_info_read_out
  inst NUMBER_TO_COMPOSITE cc3_ext_packed_bool_to_composite : number=cc3_ext_packed_bool_number_read_out -> out=cc3_ext_packed_bool_to_composite_out
  inst COMPOSITE_WRITE_NUMBER simpleif_tx_number_write (count=7, offset=1) : in1=car_status_number_encode_out, in2=cc3_ext_0x4c_info_read_out, in3=car_position_number_out, in4=total_car_count_for_door_calc_read_out, in5=door_mode_register_out, in6=doorcut_front_register_out, in7=doorcut_back_register_out, inc=cc3_ext_packed_bool_to_composite_out -> out=simpleif_tx_number_write_out
  inst BLINKER local_mode_blinker_5s (on_time=5, off_time=5) : enable=local_mode_timer_out -> out=local_mode_blinker_5s_out
  inst PULSE local_mode_blinker_rise_pulse (mode="rise") : a=local_mode_blinker_5s_out -> out=local_mode_blinker_rise_pulse_out
