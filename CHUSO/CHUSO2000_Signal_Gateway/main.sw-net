  # --- Car Status (0x4B) composite for Simple IF TX ---
  inst COMPOSITE_READ_BOOLEAN pantograph1_lock_status_read (channel=5) : composite="Rolling Stock Status w/ Inertia Composite" -> out=pantograph1_lock_status_read_out
  inst COMPOSITE_READ_BOOLEAN pantograph1_raised_status_read (channel=6) : composite="Rolling Stock Status w/ Inertia Composite" -> out=pantograph1_raised_status_read_out
  inst COMPOSITE_READ_BOOLEAN pantograph2_lock_status_read (channel=7) : composite="Rolling Stock Status w/ Inertia Composite" -> out=pantograph2_lock_status_read_out
  inst COMPOSITE_READ_BOOLEAN pantograph2_raised_status_read (channel=8) : composite="Rolling Stock Status w/ Inertia Composite" -> out=pantograph2_raised_status_read_out
