  inst NUM_SWITCHBOX nits_ext_enabled_flag_number : a=nits_ext_enabled_const_one_value, switch=local_mode_timer_out -> out=nits_ext_enabled_flag_number_out
  inst COMPOSITE_WRITE_BOOLEAN simpleif_tx_encoder_input_write (count=8, offset=16) : in1=local_mode_timer_out, in3=cc3_front_id_tx_flag_read_out, in4=sos_button_or_out, in5=low_battery_check_out, in6=motor_lua_fault_read_out, in7=cp_request_and_local_mode_and_out, in8=cp_command_or_out, inc=simpleif_tx_number_write_out -> out=simpleif_tx_encoder_input_write_out
