  # --- Extended Commands: final composite assembly ---
  inst COMPOSITE_WRITE_NUMBER extended_commands_number_write (count=30, offset=1) : in1=memory_register_1_out, in2=memory_register_2_out, in3=memory_register_3_out, in4=memory_register_4_out, in5=memory_register_5_out, in6=memory_register_6_out, in7=memory_register_7_out, in8=memory_register_8_out, in9=door_mode_passthrough_out, in10=doorcut_front_passthrough_out, in11=doorcut_back_passthrough_out, in12=doorcut_front_local_passthrough_out, in13=doorcut_back_local_passthrough_out, in27=packed_car_power_brake_number_read_out, in28=packed_car_fault_status_number_read_out, in29=packed_car_door_status_number_read_out, in30=car_position_number_out -> out=extended_commands_number_write_out
