  inst COMPOSITE_READ_BOOLEAN high_accel_end_remote_read (channel=17) : composite=car_info_packer_lua_composite -> out=high_accel_end_remote_read_out
  inst SR_LATCH siv_permission_latch : r=siv_running_remote_read_out, s=siv_stopped_remote_read_out -> not_q=siv_permission_latch_not_q
