  inst COMPOSITE_READ_BOOLEAN simpleif_cmd_ready_mode13_read (channel=13) : composite=simpleif_tx_encoder_lua_composite -> out=simpleif_cmd_ready_mode13_read_out
  inst COMPOSITE_READ_BOOLEAN simpleif_cmd_ready_mode15_read (channel=15) : composite=simpleif_tx_encoder_lua_composite -> out=simpleif_cmd_ready_mode15_read_out
  inst COMPOSITE_READ_BOOLEAN simpleif_cmd_ready_mode14_read (channel=14) : composite=simpleif_tx_encoder_lua_composite -> out=simpleif_cmd_ready_mode14_read_out
  inst OR simpleif_push_trigger_or : a=simpleif_cmd_ready_mode14_read_out -> out=simpleif_push_trigger_or_out
  inst COMPOSITE_READ_NUMBER simpleif_cmd_value_back_read (channel=6) : composite=simpleif_tx_encoder_lua_composite -> out=simpleif_cmd_value_back_read_out
  inst COMPOSITE_READ_NUMBER simpleif_cmd_value_front_read (channel=7) : composite=simpleif_tx_encoder_lua_composite -> out=simpleif_cmd_value_front_read_out
  inst OR simpleif_interrupt_trigger_or : a=simpleif_cmd_ready_mode13_read_out -> out=simpleif_interrupt_trigger_or_out
  inst OR simpleif_override_trigger_or : a=simpleif_cmd_ready_mode15_read_out -> out=simpleif_override_trigger_or_out

  # --- NITS TX: assemble command composite & write to bus ---
  inst COMPOSITE_WRITE_NUMBER nits_tx_number_write (count=6, offset=4) : in1=brake_cylinder_pressure_read_out, in2=motor_current_gated_by_axle_out, in3=simpleif_cmd_value_back_read_out, in4=simpleif_cmd_value_front_read_out, in5=nits_ext_enabled_flag_number_out, in6=total_car_count_for_nits_read_out, inc="Control Commands Type 3 front" -> out=nits_tx_number_write_out
  inst COMPOSITE_WRITE_BOOLEAN nits_tx_command_write (count=7, offset=3) : in1=car_fault_report_or_out, in2="Door Open (A)", in3="Door Open (B)", in4=rx_addr_conflict_read_out, in5=simpleif_interrupt_trigger_or_out, in6=simpleif_push_trigger_or_out, in7=simpleif_override_trigger_or_out, inc=nits_tx_number_write_out -> out=nits_tx_command_write_out
  inst COMPOSITE_WRITE_BOOLEAN nits_tx_bus_write (count=6, offset=1) : in1=nits_tx_strobe_cap_out, in2=cc3_front_direction_select_front_read_out, in3=cc3_front_direction_select_back_read_out, in4=cc3_front_emergency_brake_read_out, in5=to_nits_reserved_bit_fixed_value_out, in6=cc3_front_direction_select_conflict_read_out, inc=nits_tx_encoder_lua_composite -> out="to NITS"

end
